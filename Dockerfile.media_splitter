FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY media_splitter_requirements.txt .
RUN pip install --no-cache-dir -r media_splitter_requirements.txt
COPY media_splitter_bot.py .
CMD ["python", "media_splitter_bot.py"]
